eur, ancienne_couleur\&quot;/]\n        f24_B --&gt; f24_C[\&quot;i = 0\&quot;]\n        f24_C --&gt; f24_D{\&quot;i &lt; nb_cartes ?\&quot;}\n        f24_D --&gt;|Oui| f24_E{\&quot;carte i a la couleur ancienne_couleur ?\&quot;}\n        f24_E --&gt;|Oui| f24_V[/\&quot;Retourner VRAI\&quot;/]\n        f24_E --&gt;|Non| f24_F[\&quot;i = i + 1\&quot;]\n        f24_F --&gt; f24_D\n        f24_D --&gt;|Non| f24_W[/\&quot;Retourner FAUX\&quot;/]\n        f24_V --&gt; f24_G([Fin])\n        f24_W --&gt; f24_G\n    end\n\n    subgraph f25_sg[\&quot;25 - gerer_appel_bluff\&quot;]\n        direction TD\n        f25_A([Début]) --&gt; f25_B[\&quot;poseur = courant, appelant = joueur suivant\&quot;]\n        f25_B --&gt; f25_C{\&quot;Appelant = ordinateur ?\&quot;}\n        f25_C --&gt;|Oui| f25_D[\&quot;appel = aléatoire 0 à 99 inférieur à 30\&quot;]\n        f25_C --&gt;|Non| f25_E[/\&quot;Demander : Bluff ? o ou n\&quot;/]\n        f25_E --&gt; f25_F[\&quot;appel = saisie égale à o\&quot;]\n        f25_D --&gt; f25_G{\&quot;appel ?\&quot;}\n        f25_F --&gt; f25_G\n        f25_G --&gt;|Non| f25_H[\&quot;Appelant pioche 4 cartes\&quot;]\n        f25_H --&gt; f25_I[\&quot;Appelant saute son tour\&quot;]\n        f25_I --&gt; f25_Z([Fin])\n        f25_G --&gt;|Oui| f25_J{\&quot;y_a_t_il_bluff ?\&quot;}\n        f25_J --&gt;|Oui| f25_K[/\&quot;Afficher : Bluff réussi\&quot;/]\n        f25_K --&gt; f25_L[\&quot;Poseur pioche 4 cartes\&quot;]\n        f25_L --&gt; f25_Z\n        f25_J --&gt;|Non| f25_M[/\&quot;Afficher : Bluff raté\&quot;/]\n        f25_M --&gt; f25_N[\&quot;Appelant pioche 6 cartes\&quot;]\n        f25_N --&gt; f25_O[\&quot;Appelant saute son tour\&quot;]\n        f25_O --&gt; f25_Z\n    end\n\n    subgraph f26_sg[\&quot;26 - verifier_annonce_uno\&quot;]\n        direction TD\n        f26_A([Début]) --&gt; f26_B[/\&quot;Entrées : main, saisie\&quot;/]\n        f26_B --&gt; f26_C[\&quot;a_dit_uno = saisie égale à UNO\&quot;]\n        f26_C --&gt; f26_D{\&quot;nb_cartes = 1 et pas a_dit_uno ?\&quot;}\n        f26_D --&gt;|Oui| f26_P[/\&quot;Retourner 2\&quot;/]\n        f26_D --&gt;|Non| f26_E{\&quot;nb_cartes &gt; 1 et a_dit_uno ?\&quot;}\n        f26_E --&gt;|Oui| f26_P\n        f26_E --&gt;|Non| f26_Q[/\&quot;Retourner 0\&quot;/]\n        f26_P --&gt; f26_Z([Fin])\n        f26_Q --&gt; f26_Z\n    end\n\n    subgraph f27_sg[\&quot;27 - partie_finie\&quot;]\n        direction TD\n        f27_A([Début]) --&gt; f27_B[\&quot;joueur = 0\&quot;]\n        f27_B --&gt; f27_C{\&quot;joueur &lt; nb_joueurs ?\&quot;}\n        f27_C --&gt;|Oui| f27_D{\&quot;Main du joueur vide ?\&quot;}\n        f27_D --&gt;|Oui| f27_V[/\&quot;Retourner VRAI\&quot;/]\n        f27_D --&gt;|Non| f27_E[\&quot;joueur = joueur + 1\&quot;]\n        f27_E --&gt; f27_C\n        f27_C --&gt;|Non| f27_W[/\&quot;Retourner FAUX\&quot;/]\n        f27_V --&gt; f27_Z([Fin])\n        f27_W --&gt; f27_Z\n    end\n\n    subgraph f28_sg[\&quot;28 - main\&quot;]\n        direction TD\n        f28_A([Début]) --&gt; f28_B[\&quot;Initialiser le générateur aléatoire\&quot;]\n        f28_B --&gt; f28_C[/\&quot;Lire nb_joueurs\&quot;/]\n        f28_C --&gt; f28_D[\&quot;preparer_partie\&quot;]\n        f28_D --&gt; f28_E[\&quot;afficher_table\&quot;]\n        f28_E --&gt; f28_F{\&quot;courant = 0 ?\&quot;}\n        f28_F --&gt;|Oui| f28_G[\&quot;tour_du_joueur\&quot;]\n        f28_F --&gt;|Non| f28_H[\&quot;tour_de_l_ordinateur\&quot;]\n        f28_G --&gt; f28_I{\&quot;partie_finie ?\&quot;}\n        f28_H --&gt; f28_I\n        f28_I --&gt;|Non| f28_J[\&quot;passer_au_joueur_suivant\&quot;]\n        f28_J --&gt; f28_E\n        f28_I --&gt;|Oui| f28_K[/\&quot;Afficher le gagnant\&quot;/]\n        f28_K --&gt; f28_L([Fin])\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="R71RzlE07Wg0LGMRaAzX-280">
